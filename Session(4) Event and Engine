using System;
using System.Collections.Generic;
using System.Linq;
using System.Net;
using System.Net.Sockets;
using System.Text;
using System.Threading.Tasks;

namespace ServerCore
{
    class Listener  //문지기를 분리해서 관리
    {
        Socket _listenSocket;
        Func<Session> _sessionFactory; //반환 값 없는 델레게이트 함수를 받아오기위해 선언? 

        public void Init(IPEndPoint endPoint, Func<Session> sessionFactory )  // 식당의 주소와 핸드폰 생성 함수를 델레게이트로 받아와서 문지기 초기화.
        {
           
            _listenSocket = new Socket(endPoint.AddressFamily, SocketType.Stream, ProtocolType.Tcp);  //문지기이자 문지기의 핸드폰(손님과의 소통(문의)을위한)을 만들어줌
            _sessionFactory += sessionFactory;        // 매개 변수로 받은 함수를 구독?

            // 문지기 교육 손님을 받을 준비
            // 문지기에게 식당의 위치와 문 위치를 알려줌. 식당입구에 배치
            _listenSocket.Bind(endPoint);

            // 영업시작 손님이 오길 기다림
            // 최대 대기자 수를 10으로 제한
            _listenSocket.Listen(10);   

            SocketAsyncEventArgs args = new SocketAsyncEventArgs();                             // args는 문지기 Socket의 현재 상태를 받아옴. 클라이언트의 현재 상황을 나타냄 (Accept, send, receive, Error(입장 성공/실패))  
            args.Completed += new EventHandler<SocketAsyncEventArgs>(OnAcceptCompleted);        // 손님이 pending = true (보류중) 에 식당에 들어왔을 때를 대비해서 Handler를 Completed 상황에 자동으로 실행되도록 함수를 구독함.
            RegisterAccept(args);                                                               
        }



        void RegisterAccept(SocketAsyncEventArgs args)  // 초기화에서 바로 등록함수로 args(손님의 상태)를 매개변수로 받아서 들어옴
        {                                               
            args.AcceptSocket = null;                   // 클라이언트 대리자 생성 후 다음 손님을 받기위해 null로 초기화. AcceptSocket은 손님

            bool pending = _listenSocket.AcceptAsync(args); // pending -> 보류중 을 뜻하기 때문에 _listenSocket.AcceptAsync로 현재 접근 중인지 bool값으로 확인
            if (pending == false)                           // 보류중이 아닌 영업이 시작되자마자 손님이 들어왔을 경우만 처리 해주기때문에 위에 초기화 함수에서 따로 델레게이트를 받음.
                OnAcceptCompleted(_listenSocket, args);     // sender(이벤트 발생 주체) : 문지기 , args(손님의 상태) : 손님 소켓의 상태 
        }



        void OnAcceptCompleted(object sender, SocketAsyncEventArgs args)        // sender는 문지기 자체를 받고 args는 손님의 소켓을 받아옴
        {
            if(args.SocketError == SocketError.Success)     // 클라이언트가 입장을 완료 했다면
            {
                Session session = _sessionFactory.Invoke();
                session.Start(args.AcceptSocket);
                session.OnConnected(args.AcceptSocket.RemoteEndPoint);
            }
            else
                Console.WriteLine(args.SocketError.ToString());     //클라이언트의 소캣이 생성 되지않았을 시 에러내용 출력

            RegisterAccept(args);   // 소캣 생성이 완료되었으니 다음 손님을 받기위해 다시 등록 RegisterAccept로 돌아감 사실상 초기 Init을 해주면 while문을 도는것과 같은 현상을 보임.
        }

    }
}
